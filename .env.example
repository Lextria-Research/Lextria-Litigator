# =====================================================================
# Lextria Office Executive — Environment Variables Template
# Copy this file to .env.local for local development.
# In Vercel, set these in Project Settings -> Environment Variables.
# NEVER commit real credentials to Git (the repository is public).
# =====================================================================

# ---------------------------------------------------------------------
# 1. Supabase (Primary Database & Auth)
# ---------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# 2. Authentication Mode ('test' | 'otp')
# 'test': Email & password test accounts (default for prototype testing)
# 'otp': Invite-only 6-digit one-time code via email
# ---------------------------------------------------------------------
VITE_AUTH_MODE=test

# ---------------------------------------------------------------------
# 3. Zoho WorkDrive (Document & File Cloud Storage)
# ---------------------------------------------------------------------
VITE_WORKDRIVE_ROOT_FOLDER_ID=
VITE_ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ---------------------------------------------------------------------
# 4. Zoho Cliq (Team Bot Webhook Alerts)
# ---------------------------------------------------------------------
ZOHO_CLIQ_WEBHOOK_URL=

# ---------------------------------------------------------------------
# 5. Zoho Mail Custom SMTP (For Supabase Auth OTP Delivery)
# Configured in Supabase Dashboard -> Authentication -> SMTP Settings:
#   Host: smtppro.zoho.com (or smtp.zoho.com)
#   Port: 465 (SSL) or 587 (TLS)
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=
